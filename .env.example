# The shared enrolment key. Gets this agent through the door once, at which point it
# is handed a token of its own and this key is no longer used for anything.
API_KEY=

# Where the API lives, without a trailing slash. e.g. https://api.example.com
CONFIG_URL=

# ipinfo.io token. Optional: without it the agent enrols with no location, and the
# console shows it as "location unknown".
GEO_API_KEY=

# Optional. What this probe is called in the console. Left blank, the server names it
# after wherever it says it is - "Reykjavik, IS".
AGENT_NAME=

# Optional. Set either of these to skip the state file: AGENT_TOKEN pins an identity
# issued elsewhere, AGENT_STATE_FILE moves where the agent keeps the one it earned.
AGENT_TOKEN=
AGENT_STATE_FILE=
